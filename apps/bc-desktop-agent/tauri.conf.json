{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Borrowed Compute Agent",
  "version": "0.1.0",
  "identifier": "dev.borrowedcompute.agent",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Borrowed Compute Agent",
        "width": 420,
        "height": 640,
        "minWidth": 380,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Run jobs from your paired devices on this Mac.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCNzRCRENCRTYyRUI0MjcKUldRbnRDN215NzEwcStGSDVoT3piNWdKcGo4UEFqbHY4VWRDVHVucDdaNDE4QW95RVdlUi9zeTgK",
      "endpoints": [
        "https://github.com/Harshil089/Borrowed-Compute-releases/releases/latest/download/agent.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
